  - m_Id: 1300670366867461
    m_Localized: "zasi\u0119g \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1300670366867458
    m_Localized: Pusto. Wszystkie nagrody rozdane
    m_Metadata:
      m_Items: []
  - m_Id: 1342900070768640
    m_Localized: "Nagrody si\u0119 sko\u0144czy\u0142y. Ka\u017Cde zakr\u0119cenie
      daje bomb\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 1300670366867459
    m_Localized: "Ka\u017Cde zakr\u0119cenie daje nagrod\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 2862273583374336
    m_Localized: Nagrody
    m_Metadata:
      m_Items: []
  - m_Id: 1300670366867457
    m_Localized: "Pozosta\u0142o nagr\xF3d: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2515866812932099
    m_Localized: "Wszystkie cz\u0119\u015Bci zamontowane"
    m_Metadata:
      m_Items: []
  - m_Id: 2515866812932100
    m_Localized: "Przytrzymaj, aby ulepszy\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 2515866812932097
    m_Localized: 'Ulepszenia: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2515866812932101
    m_Localized: Maksimum
    m_Metadata:
      m_Items: []
  - m_Id: 2515866812932098
    m_Localized: "Nast\u0119pna cz\u0119\u015B\u0107: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 1300670366867456
    m_Localized: "Zakr\u0119\u0107 \xB7 ${0}"
    m_Metadata:
      m_Items: []
  - m_Id: 426762242
    m_Localized: "Terminal ulepsze\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 426762250
    m_Localized: "Przywr\xF3\u0107 zablokowane samochodziki"
    m_Metadata:
      m_Items: []
  - m_Id: 334677012373508
    m_Localized: Wibracje
    m_Metadata:
      m_Items: []
  - m_Id: 2515866812932104
    m_Localized: Tak, resetuj
    m_Metadata:
      m_Items: []
  - m_Id: 566074793985
    m_Localized: "Klawisz 2: przyci\u0105ga takie same samochodziki z okolicy do
      ekwipunku"
    m_Metadata:
      m_Items: []
  - m_Id: 566074793984
    m_Localized: Autozbieranie
    m_Metadata:
      m_Items: []
  - m_Id: 565756026881
    m_Localized: "Samochodzik rzucony w sw\xF3j rega\u0142 sam trafia na p\xF3\u0142k\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 565756026880
    m_Localized: Autoustawianie przy rzucie
    m_Metadata:
      m_Items: []
  - m_Id: 565537923073
    m_Localized: "Trzymaj Ctrl, aby kuca\u0107 pod p\xF3\u0142kami"
    m_Metadata:
      m_Items: []
  - m_Id: 565537923072
    m_Localized: Odblokuj kucanie
    m_Metadata:
      m_Items: []
  - m_Id: 565969936385
    m_Localized: "Klawisz 1: pasuj\u0105ce samochodziki w stercie \u015Bwiec\u0105
      i unosz\u0105 si\u0119 w g\xF3r\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 565969936384
    m_Localized: "Znajd\u017A pasuj\u0105ce"
    m_Metadata:
      m_Items: []
  - m_Id: 565210767360
    m_Localized: +1 miejsce za poziom, maks. 15
    m_Metadata:
      m_Items: []
  - m_Id: 565202378752
    m_Localized: "Wi\u0119kszy ekwipunek"
    m_Metadata:
      m_Items: []
  - m_Id: 565324013569
    m_Localized: "Bierz i stawiaj samochodziki z wi\u0119kszej odleg\u0142o\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 565324013568
    m_Localized: "Wi\u0119kszy zasi\u0119g"
    m_Metadata:
      m_Items: []
  - m_Id: 565860884481
    m_Localized: "Klawisz 3: pod\u015Bwietla rega\u0142 dla samochodzika w r\u0119ce"
    m_Metadata:
      m_Items: []
  - m_Id: 565860884480
    m_Localized: "Pod\u015Bwietlenie rega\u0142u"
    m_Metadata:
      m_Items: []
  - m_Id: 565433065473
    m_Localized: Trzymaj Shift, aby biec
    m_Metadata:
      m_Items: []
  - m_Id: 565433065472
    m_Localized: Odblokuj sprint
    m_Metadata:
      m_Items: []
  - m_Id: 565646974976
    m_Localized: "Samochodziki lec\u0105 dalej"
    m_Metadata:
      m_Items: []
  - m_Id: 565642780672
    m_Localized: Mocniejszy rzut
    m_Metadata:
      m_Items: []
